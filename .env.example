# ---------------------------------------------------------------------------
# Bolldr CRM — environment variables
# Copy this file to ".env" for local development and set the same variables in
# your Vercel project settings (Project > Settings > Environment Variables).
# ---------------------------------------------------------------------------

# Postgres connection string.
# Free open-source options that work on Vercel:
#   - Neon       (https://neon.tech)        — recommended, serverless Postgres
#   - Supabase   (https://supabase.com)     — open-source Postgres + dashboard
#   - Vercel Postgres (Neon under the hood) — provision from the Vercel dashboard
# Use the "pooled" connection string for the serverless runtime.
DATABASE_URL="postgresql://user:password@host:5432/bolldr_crm?sslmode=require"

# Secret used to sign auth session tokens (JWT). Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL of the deployment. For local dev use http://localhost:3000.
# On Vercel this is set automatically, but setting it explicitly is safest.
NEXTAUTH_URL="http://localhost:3000"

# Credentials for the first admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@bolldr.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe!123"
SEED_ADMIN_NAME="Bolldr Admin"
