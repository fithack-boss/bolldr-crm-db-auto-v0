# ---------------------------------------------------------------------------
# Bolldr CRM — environment variables
# Copy this file to ".env" for local development and set the same variables in
# your Vercel project settings (Project > Settings > Environment Variables).
# ---------------------------------------------------------------------------

# --- Database: Supabase (free, open-source Postgres) -----------------------
# In the Supabase dashboard: Project Settings > Database > Connection string.
#
# DATABASE_URL = the "Transaction" pooler string (host ends in
#   ".pooler.supabase.com", port 6543). Add ?pgbouncer=true — this is what the
#   app uses at runtime on Vercel's serverless functions.
#
# DIRECT_URL   = the "Session"/direct string (port 5432). Prisma uses this for
#   `prisma db push` (schema creation) during the build.
#
# (Supabase shows both; just copy each one and add your DB password.)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret used to sign auth session tokens (JWT). Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL of the deployment.
#   - Local dev:  http://localhost:3000
#   - Production: your dedicated CRM URL, e.g. https://crm.bolldr.com
NEXTAUTH_URL="http://localhost:3000"

# --- Self-registration ------------------------------------------------------
# Your team self-registers at /register and signs in with email + password.
#
# ADMIN_EMAIL: this address is automatically granted the ADMIN role when it
#   registers (or is seeded). Everyone else becomes a Sales Rep.
ADMIN_EMAIL="jadabboud@bolldr.com"
#
# ALLOWED_SIGNUP_DOMAINS: comma-separated email domains allowed to self-register
#   (keeps strangers off your CRM). Set to "" to allow any domain.
ALLOWED_SIGNUP_DOMAINS="bolldr.com,fithack.ae"

# Optional: seed a first admin account via `npm run db:seed` (defaults to
# ADMIN_EMAIL above). Once registration is live you can skip seeding entirely
# and just register the admin email.
SEED_ADMIN_EMAIL="jadabboud@bolldr.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe!123"
SEED_ADMIN_NAME="Jad Abboud"
